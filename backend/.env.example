# Deterministic local showcase fallback
SPECL00M_CONTEXT_MODE=deterministic
SPECL00M_ARCHITECT_MODE=showcase
SPECL00M_RUNTIME_MODE=local
SPECL00M_STORAGE_MODE=memory

# Production AWS compiler/runtime
SPECL00M_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-west-2

SPECL00M_DDB_TABLE=specloom-projects
SPECL00M_S3_BUCKET=specloom-project-sources
SPECL00M_SAGEMAKER_ENDPOINT_NAME=

SPECL00M_CORS_ORIGINS=http://localhost:5173
SPECL00M_ALLOW_CREDENTIALS=false
SPECL00M_PUBLIC_URL=
SPECL00M_AGENTCORE_RUNTIME_ARN=

# Optional live GitHub capability
SPECL00M_GITHUB_TOKEN=
SPECL00M_GITHUB_REPOSITORY=

# Optional read-only MCP capability catalog.
# JSON can be a {"mcpServers": {...}} object or a flat server map.
SPECL00M_MCP_SERVERS=
# Explicit trust boundary: only these configured servers may be used by generated agents.
SPECL00M_MCP_READONLY_SERVERS=[]
