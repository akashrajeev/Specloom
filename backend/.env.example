# Deterministic local showcase fallback
SPECL00M_CONTEXT_MODE=deterministic
SPECL00M_ARCHITECT_MODE=showcase
SPECL00M_REVIEW_MODE=none
SPECL00M_RUNTIME_MODE=local
SPECL00M_STORAGE_MODE=memory

# Production AWS compiler/runtime
SPECL00M_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SPECL00M_ALLOWED_BEDROCK_MODELS=amazon.nova-lite-v1:0
# Production builds can set this to bedrock for adversarial semantic review.
AWS_REGION=us-west-2

SPECL00M_DDB_TABLE=specloom-projects
SPECL00M_S3_BUCKET=specloom-project-sources
SPECL00M_SAGEMAKER_ENDPOINT_NAME=

SPECL00M_CORS_ORIGINS=http://localhost:5173
SPECL00M_ALLOW_CREDENTIALS=false
SPECL00M_PUBLIC_URL=
SPECL00M_AGENTCORE_RUNTIME_ARN=

# Optional live GitHub capability
SPECL00M_GITHUB_TOKEN=
SPECL00M_GITHUB_REPOSITORY=

# Optional read-only MCP capability catalog.
SPECL00M_MCP_SERVERS=
SPECL00M_MCP_READONLY_SERVERS=[]

# Optional durable orchestration via AWS Step Functions.
SPECL00M_STEP_FUNCTIONS_ROLE_ARN=
SPECL00M_STEP_FUNCTIONS_WORKER_ARN=
SPECL00M_STEP_FUNCTIONS_APPROVAL_ARN=
SPECL00M_STEP_FUNCTIONS_NAME_PREFIX=specloom

# Configuration-driven authenticated APIs.
# Secrets are referenced by environment-variable name; secret values never enter workflow IR or prompts.
# Example:
# SPECL00M_API_ENDPOINTS={"crm":{"base_url":"https://api.example.com","description":"CRM API","capabilities":["customers","tickets"],"read_methods":["GET"],"write_methods":["POST","PATCH"],"auth_env":"CRM_API_TOKEN","auth_header":"Authorization","auth_prefix":"Bearer "}}
SPECL00M_API_ENDPOINTS=
