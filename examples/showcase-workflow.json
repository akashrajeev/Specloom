{
  "ir_version":"0.1",
  "id":"research-hunter-v1",
  "name":"ResearchHunter",
  "description":"Research AI developments and prepare GitHub issues for human approval.",
  "trigger":{"id":"daily","type":"trigger","name":"Daily trigger","config":{"mode":"schedule","cron":"0 8 * * *"}},
  "nodes":[
    {"id":"research","type":"agent","name":"Research","config":{"role":"Find recent AI research from configured sources.","model":"bedrock","tools":["web_search"],"output_mode":"structured"}},
    {"id":"relevance","type":"agent","name":"Relevance","config":{"role":"Judge relevance against project context.","model":"bedrock","tools":[],"output_mode":"structured"}},
    {"id":"approval","type":"human_approval","name":"Human Review","config":{"prompt":"Approve proposed GitHub issues.","approvers":["project_owner"]}},
    {"id":"github","type":"tool","name":"GitHub Create Issue","config":{"tool_ref":"github.create_issue","mode":"sandbox"}},
    {"id":"result","type":"output","name":"Report","config":{"mode":"return","destination":null}}
  ],
  "edges":[
    {"from":"daily","to":"research"},
    {"from":"research","to":"relevance"},
    {"from":"relevance","to":"approval"},
    {"from":"approval","to":"github"},
    {"from":"github","to":"result"}
  ],
  "variables":[],
  "policies":[{"id":"github-write","rules":["GitHub writes require prior human approval."]}],
  "tests":[{"id":"approval-required","name":"Approval precedes GitHub write","input":{"approved":false},"expected":{"github_called":false},"tags":["policy"]}]
}