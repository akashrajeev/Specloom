{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://specloom.dev/schema/workflow-ir/v0.1.json",
  "title":"Specloom Workflow IR",
  "type":"object",
  "required":["ir_version","id","name","trigger","nodes","edges","variables","policies","tests"],
  "properties":{
    "ir_version":{"const":"0.1"},
    "id":{"type":"string","minLength":1},
    "name":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "trigger":{"$ref":"#/$defs/trigger"},
    "nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}},
    "edges":{"type":"array","items":{"$ref":"#/$defs/edge"}},
    "variables":{"type":"array","items":{"$ref":"#/$defs/variable"}},
    "policies":{"type":"array","items":{"$ref":"#/$defs/policy"}},
    "tests":{"type":"array","items":{"$ref":"#/$defs/test"}}
  },
  "$defs":{
    "common":{
      "type":"object",
      "required":["id","type","name"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]*$"},
        "type":{"type":"string"},
        "name":{"type":"string","minLength":1},
        "description":{"type":"string"},
        "config":{"type":"object"},
        "input_contract":{"type":["object","null"]},
        "output_contract":{"type":["object","null"]},
        "policy_ref":{"type":["string","null"]},
        "retry":{"$ref":"#/$defs/retry"},
        "timeout_seconds":{"type":["integer","null"],"minimum":1}
      },
      "additionalProperties":true
    },
    "trigger":{
      "allOf":[
        {"$ref":"#/$defs/common"},
        {"type":"object","required":["config"],"properties":{
          "type":{"const":"trigger"},
          "config":{"type":"object","required":["mode"],"properties":{
            "mode":{"enum":["manual","schedule","webhook","event"]},
            "cron":{"type":["string","null"]},
            "event_source":{"type":["string","null"]}
          }}
        }}
      ]
    },
    "node":{
      "allOf":[
        {"$ref":"#/$defs/common"},
        {"oneOf":[
          {"$ref":"#/$defs/agent"},
          {"$ref":"#/$defs/tool"},
          {"$ref":"#/$defs/condition"},
          {"$ref":"#/$defs/parallel"},
          {"$ref":"#/$defs/loop"},
          {"$ref":"#/$defs/approval"},
          {"$ref":"#/$defs/output"}
        ]}
      ]
    },
    "agent":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"agent"},"config":{
        "type":"object","required":["role","output_mode"],
        "properties":{
          "role":{"type":"string","minLength":1},
          "instructions":{"type":["string","null"]},
          "model":{"type":["string","null"]},
          "tools":{"type":"array","items":{"type":"string"}},
          "memory":{"type":["object","null"]},
          "output_mode":{"enum":["text","json","structured"]}
        }
      }}
    },
    "tool":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"tool"},"config":{
        "type":"object","required":["tool_ref","mode"],
        "properties":{
          "tool_ref":{"type":"string","minLength":1},
          "mode":{"enum":["sandbox","mock","live"]}
        }
      }}
    },
    "condition":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"condition"},"config":{
        "type":"object","required":["expression","branches"],
        "properties":{
          "expression":{"type":"string","minLength":1},
          "branches":{"type":"array","minItems":2,"items":{"type":"string"}}
        }
      }}
    },
    "parallel":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"parallel"},"config":{
        "type":"object","required":["branches"],
        "properties":{"branches":{"type":"array","minItems":2,"items":{"type":"string"}}}
      }}
    },
    "loop":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"loop"},"config":{
        "type":"object","required":["collection","body","max_iterations"],
        "properties":{
          "collection":{"type":"string","minLength":1},
          "body":{"type":"string","minLength":1},
          "max_iterations":{"type":"integer","minimum":1,"maximum":1000},
          "stop_condition":{"type":["string","null"]}
        }
      }}
    },
    "approval":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"human_approval"},"config":{
        "type":"object","required":["prompt","approvers"],
        "properties":{
          "prompt":{"type":"string","minLength":1},
          "approvers":{"type":"array","minItems":1,"items":{"type":"string"}},
          "timeout_seconds":{"type":["integer","null"],"minimum":1}
        }
      }}
    },
    "output":{
      "type":"object","required":["type","config"],
      "properties":{"type":{"const":"output"},"config":{
        "type":"object","required":["mode"],
        "properties":{
          "mode":{"enum":["return","notify","artifact","webhook"]},
          "destination":{"type":["string","null"]}
        }
      }}
    },
    "edge":{
      "type":"object","required":["from","to"],
      "properties":{
        "from":{"type":"string"},
        "to":{"type":"string"},
        "condition":{"type":["string","null"]},
        "label":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "variable":{
      "type":"object","required":["name","type"],
      "properties":{"name":{"type":"string"},"type":{"type":"string"},"default":{}},
      "additionalProperties":true
    },
    "policy":{
      "type":"object","required":["id","rules"],
      "properties":{"id":{"type":"string"},"rules":{"type":"array","items":{"type":"string"}}},
      "additionalProperties":true
    },
    "test":{
      "type":"object","required":["id","name","input","expected"],
      "properties":{"id":{"type":"string"},"name":{"type":"string"},"input":{},"expected":{},"tags":{"type":"array","items":{"type":"string"}}},
      "additionalProperties":false
    },
    "retry":{
      "type":"object",
      "properties":{"max_attempts":{"type":"integer","minimum":0,"maximum":10},"backoff_seconds":{"type":"number","minimum":0}},
      "additionalProperties":false
    }
  }
}